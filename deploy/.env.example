# TaskForge self-hosted configuration.
#   cp deploy/.env.example deploy/.env  &&  edit every value marked CHANGE ME
#
# Every variable below without a default is REQUIRED. The stack refuses to start
# rather than coming up misconfigured — a deployment that starts wrong is worse
# than one that does not start (docs/48 §Configuration).

# --- Database -------------------------------------------------------------
POSTGRES_USER=taskforge_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
POSTGRES_DB=taskforge

# NOTE (D-050): the connection to PostgreSQL is NOT encrypted. The database must
# be on a trusted network — this host, or a private subnet you control. A
# managed PostgreSQL requiring sslmode=require is not supported by this release.
# See docs/52 §The database connection is NOT encrypted.
#
# The application connects as this role, NOT as the owner above. A superuser
# bypasses row-level security unconditionally, which would make tenant isolation
# and append-only history both inert (migration 0012).
TASKFORGE_DB_PASSWORD=CHANGE_ME_app_password

# The outbox dispatcher connects as a THIRD role. It bypasses row-level security
# because it must poll every tenant — a background worker cannot know the set of
# workspace ids in advance — and migration 0014 bounds that by granting it
# nothing outside the two outbox tables.
#
# Use a DIFFERENT secret from TASKFORGE_DB_PASSWORD above. Reusing it means the
# credential every request path uses also unlocks the one that ignores tenant
# isolation.
TASKFORGE_DISPATCHER_PASSWORD=CHANGE_ME_dispatcher_password

# --- Application ----------------------------------------------------------
TASKFORGE_IMAGE=ghcr.io/casualoffice/taskforge:latest
TF_HTTP_PORT=8080

# Where users reach TaskForge. Used in emails and OIDC redirect URIs.
TF_PUBLIC_URL=https://tasks.example.com

# MUST be a different origin from TF_PUBLIC_URL — not a different path, a
# different HOST. User-uploaded files are served from here, and sharing the
# origin means a stored HTML or SVG attachment executes with access to
# application cookies (docs/28 §Serving downloads).
TF_ATTACHMENT_ORIGIN=https://files.tasks.example.com

# Signs sessions and cookies. Generate with:  openssl rand -base64 48
# Rotating this invalidates every session — which is the correct response to
# suspected exposure.
TF_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48

# --- Email (optional; notifications degrade to in-app only without it) -----
#
# Leave TF_SMTP_HOST empty to disable email entirely. In-app notifications are
# the system of record either way (docs/29 §Delivery: the notification row is
# always written; email is one channel on top of it), so an unset relay costs
# delivery, not truth.
#
# TF_SMTP_USER / TF_SMTP_PASS are for relays that require authentication, which
# is almost all of them. Port 587 is the submission port and implies STARTTLS.
#
# SETTLED (tracker D-046): STARTTLS is REQUIRED and the relay's certificate and
# hostname ARE verified against the platform trust store. A relay that does not
# offer STARTTLS is refused rather than fallen back from — there is no
# configuration key that weakens either, because what crosses this connection is
# a password-reset link and TF_SMTP_PASS.
#
# TF_SMTP_FROM must be a BARE address (no "Name <addr>" form). Rendering a
# display name safely needs an RFC 2047 encoder, which is not in the dependency
# set; the process refuses to start rather than mangling it in every email.
TF_SMTP_HOST=
TF_SMTP_PORT=587
TF_SMTP_USER=
TF_SMTP_PASS=
TF_SMTP_FROM=taskforge@example.com
