# Copy to .env for local development. See docs/48-DEPLOYMENT-PROFILES.md.
DATABASE_URL=postgres://taskforge:taskforge@localhost:5432/taskforge
TF_BIND_ADDR=0.0.0.0:8080
TF_PUBLIC_URL=http://localhost:8080
# Must differ from TF_PUBLIC_URL — sharing the origin defeats attachment
# isolation (docs/28). The application refuses to start if they match.
TF_ATTACHMENT_ORIGIN=http://localhost:8081
TF_SECRET_KEY=dev-only-change-me-0000000000000000
TF_STORAGE_BACKEND=fs
TF_STORAGE_PATH=./data/attachments
TF_WORKER_EMBEDDED=true
TF_LOG_FORMAT=pretty
