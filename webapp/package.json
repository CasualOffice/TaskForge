{
  "name": "@taskforge/webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bundle-floor harness for the TaskForge authenticated shell (ADR-024, docs/42).",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "a11y": "vitest run src/a11y.test.tsx",
    "size-check": "node scripts/size-check.mjs",
    "measure": "vite build && node scripts/size-check.mjs",
    "measure:deps": "node scripts/measure-deps.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.23",
    "@tanstack/react-virtual": "3.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
